#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: $0 [tenant]" >&2
  echo "  Creates the least-privilege roles used by the hardened Compose stack and applies migrations as the admin role." >&2
  echo "  tenant: one of safetrust or hotel_industry (default: safetrust)" >&2
  exit 1
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
fi

TENANT="${1:-safetrust}"
case "$TENANT" in
  safetrust|hotel_industry) ;;
  *) usage ;;
esac

: "${PGHOST:?Set PGHOST}"
: "${PGPORT:=5432}"
: "${PGUSER:?Set PGUSER (admin role for setup)}"
: "${PGPASSWORD:?Set PGPASSWORD}"
: "${PGDATABASE:?Set PGDATABASE (admin database)}"
: "${HASURA_DB_PASSWORD:?Set HASURA_DB_PASSWORD}"
: "${HASURA_DB_USER:=hasura}"
: "${HASURA_METADATA_PASSWORD:?Set HASURA_METADATA_PASSWORD}"
: "${HASURA_METADATA_USER:=hasura_metadata}"
: "${WEBHOOK_DB_PASSWORD:?Set WEBHOOK_DB_PASSWORD}"
: "${WEBHOOK_DB_USER:=webhook}"

export PGHOST PGPORT PGUSER PGPASSWORD PGDATABASE

log() { echo "[prepare-test-db] $*" >&2; }

run_psql() {
  local database="$1"
  shift
  PGOPTIONS="--search_path=public" psql -d "$database" -v ON_ERROR_STOP=1 "$@"
}

createdb_if_missing() {
  local database="$1"
  if ! run_psql -lqt | cut -d \| -f 1 | grep -qxF "$database"; then
    log "Creating database: $database"
    createdb -e "$database" || true
  else
    log "Database already exists: $database"
  fi
}

apply_migrations() {
  log "Applying migrations as admin role for tenant: $TENANT"
  if [[ -d "migrations/$TENANT" ]]; then
    hasura migrate apply \
      --project config.yaml \
      --database-name "$TENANT" \
      --path "migrations/$TENANT" \
      --skip Headers \
      --cmd \
      || log "Migrate apply finished with warnings/errors (check logs)"
  else
    log "No migrations directory for tenant: $TENANT"
  fi
}

log "Creating least-privilege roles"

# hasura data role: can connect to the tenant DB only, no CREATE, no superuser
log "Ensuring role: $HASURA_DB_USER"
run_psql "$PGDATABASE" <<SQL || true
DO \$$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE rolname = '$HASURA_DB_USER') THEN
    CREATE ROLE "$HASURA_DB_USER" WITH LOGIN PASSWORD '$HASURA_DB_PASSWORD' NOSUPERUSER NOCREATEDB NOCREATEROLE;
  ELSE
    ALTER ROLE "$HASURA_DB_USER" WITH LOGIN PASSWORD '$HASURA_DB_PASSWORD' NOSUPERUSER NOCREATEDB NOCREATEROLE;
  END IF;
END
\$$;
GRANT CONNECT ON DATABASE "${PGDATABASE}" TO "$HASURA_DB_USER";
SQL

# hasura_metadata role owns its own metadata database only
log "Ensuring role: $HASURA_METADATA_USER"
run_psql "$PGDATABASE" <<SQL || true
DO \$$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE rolname = '$HASURA_METADATA_USER') THEN
    CREATE ROLE "$HASURA_METADATA_USER" WITH LOGIN PASSWORD '$HASURA_METADATA_PASSWORD' NOSUPERUSER NOCREATEDB NOCREATEROLE;
  ELSE
    ALTER ROLE "$HASURA_METADATA_USER" WITH LOGIN PASSWORD '$HASURA_METADATA_PASSWORD' NOSUPERUSER NOCREATEDB NOCREATEROLE;
  END IF;
END
\$$;
SQL

createdb_if_missing "hasura_metadata"
run_psql "hasura_metadata" <<SQL
GRANT ALL ON DATABASE hasura_metadata TO "$HASURA_METADATA_USER";
SQL

# webhook role: least-privilege access to the tenant DB, no CREATE, no superuser
log "Ensuring role: $WEBHOOK_DB_USER"
run_psql "$PGDATABASE" <<SQL || true
DO \$$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE rolname = '$WEBHOOK_DB_USER') THEN
    CREATE ROLE "$WEBHOOK_DB_USER" WITH LOGIN PASSWORD '$WEBHOOK_DB_PASSWORD' NOSUPERUSER NOCREATEDB NOCREATEROLE;
  ELSE
    ALTER ROLE "$WEBHOOK_DB_USER" WITH LOGIN PASSWORD '$WEBHOOK_DB_PASSWORD' NOSUPERUSER NOCREATEDB NOCREATEROLE;
  END IF;
END
\$$;
GRANT CONNECT ON DATABASE "${PGDATABASE}" TO "$WEBHOOK_DB_USER";
SQL

log "Roles created. Applying migrations as admin role."
apply_migrations
log "Done."
