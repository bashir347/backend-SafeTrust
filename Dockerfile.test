FROM node:24-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54 AS node-base # 24-bookworm-slim
FROM eclipse-temurin:17-jdk-jammy@sha256:acf46b4e646df812fd95c54669bc80d44acef68f0bde1dd420ea47897de0d637 AS jdk-base # 17-jdk-jammy

FROM node-base AS build

WORKDIR /app

COPY webhook/package.json webhook/package-lock.json ./
RUN npm ci --omit=dev

COPY webhook/tsconfig.json ./
COPY webhook/src ./src
COPY webhook/tests ./tests

FROM jdk-base AS jdk

COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/package.json /app/package-lock.json /app/tsconfig.json ./
COPY --from=build /app/src ./src
COPY --from=build /app/tests ./tests

RUN npm run build

FROM node-base AS runtime

WORKDIR /app

COPY --from=jdk /app/node_modules ./node_modules
COPY --from=jdk /app/package.json ./package-lock.json ./tsconfig.json ./
COPY --from=jdk /app/dist ./dist

EXPOSE 3000

CMD ["node", "dist/index.js"]
